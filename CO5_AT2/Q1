FUNCTION resolve_references(sentences):
    entities = extract_named_entities(sentences)
    mentions = extract_pronouns(sentences)
    links = {}

    FOR mention IN mentions:
        candidates = compatible_candidates(mention, entities)
        IF mention == "He":
            # Ravi is the salient subject; Arun is a secondary participant.
            links[mention] = choose_by_salience(candidates, preferred="Ravi")
        ELSE IF mention == "it":
            links[mention] = choose_by_semantics_and_recency(
                candidates, preferred="book")
    RETURN links

